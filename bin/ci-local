#!/usr/bin/env bash
# Local parity with GitLab RSpec matrix: Decidim 0.29 then 0.32 (full metagem suite).
# Usage: bin/ci-local [rspec paths...]
# Example: bin/ci-local decidim-restfull-core/spec/requests/
set -euo pipefail
cd "$(dirname "$0")/.."

COMPOSE=(docker compose -f docker-compose.ci.yml)
RSPEC_ARGS="${*:-decidim-restfull-*/spec}"

echo "==> rspec_029 (ruby:3.2.8 + gemfiles/decidim_0.29.gemfile)"
"${COMPOSE[@]}" run --rm -e "RSPEC_ARGS=${RSPEC_ARGS}" rspec_029

echo "==> rspec_032 (ruby:3.4.7 + gemfiles/decidim_0.32.gemfile)"
"${COMPOSE[@]}" run --rm -e "RSPEC_ARGS=${RSPEC_ARGS}" rspec_032

echo "==> ci-local done (0.29 + 0.32)"
