<%= decidim_toggle_settings_tab_form(organization, tab) do |tf| %>
  <div data-restfull-toggle-tab>
    <%= tf.fields_for_names(:enabled) %>
    <fieldset class="mt-4" data-restfull-toggle-modules>
      <legend class="form-legend"><%= t("decidim_toggle.system.decidim_restfull.modules_legend") %></legend>
      <%= tf.fields_for_names(
            :proposals_enabled,
            :blogs_enabled,
            :debates_enabled,
            :surveys_enabled,
            :forms_enabled,
            :meetings_enabled,
            :attachments_enabled,
            :budgets_enabled,
            :accountabilities_enabled,
            :sortition_enabled
          ) %>
    </fieldset>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    var root = document.querySelector("[data-restfull-toggle-tab]");
    if (!root) return;
    var master = root.querySelector('input[type="checkbox"][name$="[enabled]"]');
    var modules = root.querySelector("[data-restfull-toggle-modules]");
    if (!master || !modules) return;

    function sync() {
      var on = master.checked;
      modules.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
        input.disabled = !on;
        var field = input.closest(".field");
        if (field) field.classList.toggle("is-disabled", !on);
      });
    }

    master.addEventListener("change", sync);
    sync();
  })();
</script>
